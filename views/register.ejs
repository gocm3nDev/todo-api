<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign Up - todoToDo</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="/styles/register.css">
</head>
<body>
    <%- include('partials/navbar.ejs') %>

    <div class="auth-section">
        <div class="auth-card">
            <h2>Create Account</h2>
            <form id="form">
                <input type="text" id="username" class="form-control" name="username" placeholder="Username" required>
                <small><i id="username-alert"></i></small>
                <input type="email" id="email" class="form-control" name="email" placeholder="Email address" required>
                <small><i id="email-alert"></i></small>
                <input type="password" id="passwd" class="form-control" name="password" placeholder="Password" required>
                <input type="password" id="confirm_passwd" class="form-control" placeholder="Confirm Password" required>
                <button type="submit" id="submitButton" class="btn btn-primary btn-submit disabled">Sign Up</button>
            </form>
            <div class="auth-link">
                <small>Already have an account? <a href="#" class="text-primary">Sign In</a></small>
            </div>
        </div>
    </div>

    <script src="../scripts/inputController.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
</body>
</html>