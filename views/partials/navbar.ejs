<div class="container navbar-floating-container">
    <nav class="navbar navbar-expand-lg navbar-light navbar-custom">

        <a class="navbar-brand" style="user-select: none;" href="/">
            <i class="bi bi-check2-square me-2"></i>
            <strong>todo</strong>2Do
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain"
            aria-controls="navbarMain" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">

            <% if (user) { %>
                <div class="profile-menu ms-auto">
                    <div class="profile-toggle" id="profileToggle">
                        <% const shortName=user && user.username ? user.username.slice(0,3) : 'USR' ; %>
                            <img src="https://placehold.co/80x80/bb9af7/1a1b26?text=<%= shortName %>" alt="Profile"
                                class="profile-pic">
                            <span class="username">
                                <%= user.username %>
                            </span>
                            <i class="fa-solid fa-chevron-down"
                                style="font-size: 0.8rem; color: var(--brand-text-darker);"></i>
                    </div>

                    <div class="profile-dropdown" id="profileDropdown">
                        <div class="dropdown-header">
                            <h5>
                                <%= user.username %>
                            </h5>
                            <p>
                                <%= user.email %>
                            </p>
                        </div>
                        <ul class="dropdown-nav">
                            <li>
                                <a href="/user/dashboard">
                                    <i class="fa-solid fa-table-columns"></i>
                                    <span>Dashboard</span>
                                </a>
                            </li>
                            <li>
                                <a href="" id="logOutButton" class="logout">
                                    <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                    <span>Logout</span>
                                </a>
                            </li>
                        </ul>
                    </div>
                </div>

                <% } else { %>
                    <div class="collapse navbar-collapse" id="navbarMain">
                        <ul class="navbar-nav ms-auto gap-2">
                            <li class="nav-item">
                                <a class="btn btn-custom-outline" href="/user/sign-in">
                                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="btn btn-custom-primary" href="/user/register">
                                    <i class="bi bi-person-plus-fill me-2"></i>Register
                                </a>
                            </li>
                        </ul>
                    </div>
                    <% } %>

        </div>
    </nav>
</div>