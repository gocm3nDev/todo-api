<nav class="navbar">
    <div class="profile-menu">
        <div class="profile-toggle" id="profileToggle">
            <% const shortName = user && user.username ? user.username.slice(0,3) : 'USR'; %>
            <img src="https://placehold.co/80x80/bb9af7/1a1b26?text=<%= shortName %>" alt="Profile" class="profile-pic">
            <span class="username"><%= user.username %></span>
            <i class="fa-solid fa-chevron-down" style="font-size: 0.8rem; color: var(--brand-text-darker);"></i>
        </div>

        <div class="profile-dropdown" id="profileDropdown">
            <div class="dropdown-header">
                <h5><%= user.username %></h5>
