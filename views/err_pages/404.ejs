<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>404 - Page Not Found</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;600;800&display=swap" rel="stylesheet">

    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #1a202c;
            color: #e2e8f0;
            overflow: hidden;
        }

        #app-container {
            display: flex;
            align-items: center;
            justify-content: center;
            min-height: 100vh;
            text-align: center;
        }

        @keyframes pulse-404 {

            0%,
            100% {
                transform: scale(1);
                opacity: 1;
            }

            50% {
                transform: scale(1.03);
                opacity: 0.95;
            }
        }

        .animated-404 {
            animation: pulse-404 3s infinite ease-in-out;
            color: #718096;
            text-shadow: 0 0 10px rgba(113, 128, 150, 0.3);
        }

        @keyframes lost-task {
            0% {
                transform: rotate(0deg) translateY(0);
            }

            25% {
                transform: rotate(-3deg) translateY(-5px);
            }

            75% {
                transform: rotate(3deg) translateY(5px);
            }

            100% {
                transform: rotate(0deg) translateY(0);
            }
        }

        .lost-task-icon {
            animation: lost-task 4s infinite ease-in-out;
            color: #68d391;
            filter: drop-shadow(0 0 15px rgba(104, 211, 145, 0.5));
        }

        .clipboard-svg {
            stroke: currentColor;
            stroke-width: 2;
            stroke-linecap: round;
            stroke-linejoin: round;
            fill: none;
            display: inline-block;
        }
    </style>
</head>

<body>

    <div id="app-container" class="w-full p-4 sm:p-8">
        <div class="max-w-xl mx-auto p-8 sm:p-12">

            <div class="lost-task-icon mb-6">
                <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" viewBox="0 0 24 24"
                    class="clipboard-svg mx-auto">
                    <rect x="8" y="2" width="8" height="4" rx="1" ry="1" class="text-gray-700" fill="currentColor">
                    </rect>
                    <path d="M16 4h2a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V6a2 2 0 0 1 2-2h2"
                        class="text-gray-600" fill="currentColor"></path>

                    <line x1="12" y1="12" x2="16" y2="16" stroke="#f687b3" stroke-width="3"></line>
                    <line x1="12" y1="16" x2="16" y2="12" stroke="#f687b3" stroke-width="3"></line>
                </svg>
            </div>

            <h1 class="animated-404 text-7xl sm:text-9xl font-extrabold tracking-tight mb-4 transition duration-300">
                404
            </h1>

            <h2 class="text-2xl sm:text-3xl font-semibold text-gray-300 mb-4">
                Not Found
            </h2>

            <p class="text-gray-400 mb-8 max-w-md mx-auto">
                It seems we couldn’t find the task list you’re looking for. It may have been deleted, or you haven’t
                added this task to your list yet!
            </p>

            <a href="/" class="inline-block px-8 py-3 bg-indigo-500 text-white font-medium rounded-full shadow-lg 
                      hover:bg-indigo-400 transition duration-300 ease-in-out transform hover:scale-105 
                      focus:outline-none focus:ring-4 focus:ring-indigo-500 focus:ring-opacity-50">
                Return to Control Panel
            </a>

            <div class="mt-8 text-sm text-gray-600">
                <p>todo2DO | Never break the chain</p>
            </div>

        </div>
    </div>

</body>

</html>