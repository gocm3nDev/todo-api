<% if (todos && todos.length> 0) { %>
    <% todos.forEach(todo=> { %>
        <div class="todo-card">
            <div class="todo-card-header">
                <h3 class="todo-title">
                    <%= todo.title %>
                </h3>
                <input type="checkbox" class="todo-checkbox" id="todo-<%= todo.id %>" <%=todo.completed ? 'checked' : ''
                    %>
                >
                <label for="todo-<%= todo.id %>" class="todo-checkbox-label" aria-label="Mark as complete">
                </label>
            </div>
            <p class="todo-description">
                <%= todo.description %>
            </p>
            <div class="todo-card-footer">
                <span class="todo-tag 
                    <% if (todo.priority === 'low') { %> tag-low 
                    <% } else if (todo.priority === 'medium') { %> tag-medium 
                    <% } else if (todo.priority === 'high') { %> tag-high 
                    <% } %>">
                    <%= todo.priority.charAt(0).toUpperCase() + todo.priority.slice(1) %> PRIORITY
                </span>
                <span class="todo-date">
                    <i class="fa-solid fa-calendar-days"></i>
                    <%= todo.created_at %>
                </span>
                <div class="todo-actions">
                    <button class="btn-action btn-edit" aria-label="Edit">
                        <i class="fa-solid fa-pencil"></i>
                    </button>
                    <button class="btn-action btn-delete" aria-label="Delete">
                        <i class="fa-solid fa-trash-can"></i>
                    </button>
                </div>
            </div>
        </div>
        <% }) %>
            <% } else { %>
                <p>There is no todo for this list.</p>
                <% } %>