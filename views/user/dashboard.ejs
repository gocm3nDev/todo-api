<!DOCTYPE html>
<html lang="tr">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Dashboard</title>
    <%- include('../partials/head.ejs') %>
    <link rel="stylesheet" href="/styles/dashboard.css">
</head>

<body>

    <div class="sidebar-overlay" onclick="toggleSidebar()"></div>

    <button id="toggle-sidebar">
        <i class="fa-solid fa-bars"></i>
    </button>

    <%- include('../partials/user-sidebar.ejs') %>

    <%- include('../partials/user-navbar.ejs') %>

    <main class="main-content">
        <div class="content-card">
            <h1>Welcome, <%= user.username %></h1>
            <p>
                Burası ana içerik alanıdır. "Title" sekmesine tıkladığınızda bu alanı profil ayarlarıyla
                doldurabilirsiniz.
                "Todos" için bir yapılacaklar listesi uygulaması veya "Settings" için genel uygulama ayarları burada
                gösterilebilir.
                <br><br>
                Tasarım, istediğiniz "retro" hissi vermek için sert gölgeler ve kenarlıklar kullanır, ancak "midnight"
                renk paletiyle modern ve karanlık bir temaya sahiptir.
            </p>
        </div>

        <div class="content-card" style="margin-top: 2rem;">
            <h2>Proje İlerlemesi</h2>
            <p>Buraya başka bir içerik kartı gelebilir...</p>
        </div>
    </main>

    <script src="../../scripts/logout.js"></script>
    <script>
        const profileToggle = document.getElementById('profileToggle');
        const profileDropdown = document.getElementById('profileDropdown');

        profileToggle.addEventListener('click', () => {
            profileDropdown.classList.toggle('show');
        });

        window.addEventListener('click', function (e) {
            if (!profileToggle.contains(e.target) && !profileDropdown.contains(e.target)) {
                profileDropdown.classList.remove('show');
            }
        });

        const navLinks = document.querySelectorAll('.nav-link');

        navLinks.forEach(link => {
            link.addEventListener('click', function (e) {

                navLinks.forEach(l => l.classList.remove('active'));

                this.classList.add('active');
            });
        });

        const toggleButton = document.getElementById('toggle-sidebar');
        const sidebar = document.getElementById('sidebar');

        function toggleSidebar() {
            document.body.classList.toggle('sidebar-open');
        }

        toggleButton.addEventListener('click', (e) => {
            e.stopPropagation();
            toggleSidebar();
        });

        document.querySelector('.sidebar-overlay').addEventListener('click', toggleSidebar);

        sidebar.addEventListener('click', (e) => {
            if (window.innerWidth <= 992 && e.target.closest('a')) {
                toggleSidebar();
            }
        });

    </script>
</body>

</html>